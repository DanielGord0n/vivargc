# Supabase Configuration
# Get these from: https://supabase.com/dashboard/project/_/settings/api

NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Service role key - Project Settings -> API -> service_role.
# Server-side only. Never expose this to the browser or prefix it with
# NEXT_PUBLIC_: it bypasses Row Level Security entirely. Required once
# supabase-security.sql has been applied, because from that point the anon key
# above is read-only and every admin write goes through this key.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Contact form delivery
RESEND_API_KEY=your_resend_api_key_here

# Password for the /admin content manager. Also used to sign admin session
# cookies unless ADMIN_SESSION_SECRET is set separately, so changing it logs
# everyone out.
ADMIN_PASSWORD=your_admin_password_here

# Optional: sign admin session cookies with a dedicated secret instead of
# deriving it from ADMIN_PASSWORD.
# ADMIN_SESSION_SECRET=a_long_random_string
